{
  "schema_version": 1,
  "qualification": {
    "name": "r6.5.3f-pi-mac-dual-host-telemetry",
    "claim_scope": "telemetry-capability-qualification-only"
  },
  "inputs": {
    "network_evidence_config": "benchmark/configs/r6.5.3c-pi-mac-network-evidence.json",
    "loadgen_runtime_config": "benchmark/configs/r6.5.3b-pi-http3-loadgen.json",
    "transport_security_config": "benchmark/configs/r6.5.3e-pi-mac-http3-security.json"
  },
  "sampling": {
    "sample_count": 6,
    "interval_seconds": 1.0,
    "clock_alignment_probes": 5
  },
  "dut": {
    "provider": "darwin-local",
    "require_ac_power": true,
    "power": {
      "mode": "optional-estimated-package",
      "comparison_scope": "same-host-paired-only"
    },
    "require_no_throttling": true
  },
  "loadgen": {
    "provider": "linux-ssh",
    "power": {
      "mode": "unavailable-without-external-sensor"
    }
  }
}
