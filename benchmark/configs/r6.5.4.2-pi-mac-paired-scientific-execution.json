{
  "schema_version": 1,
  "experiment": {
    "name": "r6.5.4.2-pi-mac-paired-scientific-execution",
    "claim_scope": "controlled-paired-scientific-http3-performance-execution"
  },
  "inputs": {
    "final_freeze_config": "benchmark/configs/r6.5.4.2-pi-mac-final-freeze.json"
  },
  "execution": {
    "measurement_protocol_revision": "r6.5.4.2",
    "repetitions": 4,
    "comparison": "paired-balanced",
    "condition_order": "rotating-rounds",
    "variant_order": "balanced-by-condition-round",
    "sample_interval_seconds": 1.0,
    "server_controls": {
      "keepalive_requests": 20000
    },
    "telemetry": {
      "dut_sampling": "nonblocking-window-v2",
      "thermal_guard_interval_seconds": 5.0
    },
    "hacc_execution": {
      "mode": "repeat-frozen-planner-subset",
      "not_a_full_dataset_claim": true
    },
    "validity": {
      "require_zero_http_failures": true,
      "require_no_throttling": true,
      "loadgen_total_cpu_max_percent": 85.0,
      "loadgen_core_cpu_max_percent": 95.0
    },
    "retry_policy": "no-metric-dependent-retry",
    "outlier_policy": "retain-all-valid-runs"
  },
  "analysis": {
    "primary_metrics": [
      "application_goodput_mbps",
      "dut_process_cpu_seconds_per_gib"
    ],
    "secondary_metrics": [
      "dut_estimated_energy_j_per_gib",
      "loadgen_max_total_cpu_busy_percent",
      "loadgen_max_single_core_busy_percent"
    ],
    "pairing": "within-condition-within-repetition",
    "summary_statistic": "median-paired-delta"
  }
}
