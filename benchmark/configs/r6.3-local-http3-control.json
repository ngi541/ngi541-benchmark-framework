{
  "schema_version": 1,
  "campaign": {
    "name": "r6.3-local-http3-control",
    "alias": "R6.3 controlled local HTTP/3 qualification campaign",
    "description": "Short local qualification campaign for R6.2 measurement-control hardening. It is not intended for a performance claim."
  },
  "experiment": {
    "workload": "http3",
    "environment": "local",
    "variants": [
      "stock",
      "ngi541-direct"
    ],
    "repetitions": 4,
    "comparison": {
      "mode": "paired-balanced"
    },
    "scheduling": {
      "condition_order": "rotating-rounds",
      "variant_order": "balanced-by-condition-round"
    },
    "measurement_control": {
      "host_state": {
        "enabled": true,
        "temperature": {
          "required": true,
          "command": null,
          "sampler_interval_seconds": 1.0,
          "max_sample_age_seconds": 5.0,
          "sampler_start_timeout_seconds": 15.0
        },
        "require_ac_power": true,
        "require_no_throttling": false
      },
      "readiness": {
        "timeout_seconds": 180,
        "poll_interval_seconds": 2,
        "required_consecutive_ready_samples": 3
      },
      "runtime": {
        "stage_artifacts_once": true,
        "cleanup_attempt_runtime": true
      },
      "analysis": {
        "order_effect_warning_pp": 2.0,
        "order_effect_strong_warning_pp": 5.0
      },
      "calibration": {
        "enabled": true,
        "samples": 15,
        "sample_interval_seconds": 1.0,
        "cpu_busy_upper_quantile": 0.9
      }
    },
    "parameters": {
      "requests_per_client": 5000,
      "warmup_requests_per_client": 50,
      "cipher_suite": "TLS_AES_128_GCM_SHA256",
      "server_host": "127.0.0.1",
      "server_port": 8443,
      "worker_connections": 4096,
      "keepalive_requests": 20000,
      "startup_timeout_seconds": 10,
      "client_timeout_seconds": 60
    },
    "conditions": [
      {
        "payload_bytes": 16384,
        "workers": 1,
        "clients": 1
      },
      {
        "payload_bytes": 16384,
        "workers": 2,
        "clients": 16
      },
      {
        "payload_bytes": 16384,
        "workers": 4,
        "clients": 32
      }
    ]
  },
  "preparation": {
    "binaries": {
      "stock": {
        "path": "build/r5.4-http3/stock/bin/nginx",
        "sha256": "bcffe3477ff81f6e7fd8499704b3b10f9cea09a857e7ad196b26eca4be597be4"
      },
      "ngi541-direct": {
        "path": "build/r5.4-http3/ngi541-direct/bin/nginx",
        "sha256": "ee69fae13a781b9ddc6db411a1ffeb3638e87758ef0339a41e4f50fe66fe8b8f"
      }
    },
    "runtime_libraries": {
      "ngi541-direct": [
        {
          "path": "build/r5.4-http3/ngi541-direct/lib/libngi541_engine.0.1.dylib",
          "sha256": "f63e60ba04e5f2cdd4876f0ac416e17c4e533658b68b6e732a4dba5ee9f96f3e"
        }
      ]
    },
    "source_requirements": {
      "ngi541-nginx": {
        "path": ".",
        "tracked_clean": true
      },
      "ngi541": {
        "path": "../ngi541",
        "commit": "e78865845aaa033330b00892388d9d5af749d971",
        "tracked_clean": true
      }
    },
