{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngi541.org/schemas/workload-plan.schema.json",
  "title": "NGI541 frozen scientific HTTP/3 workload plan",
  "type": "object",
  "required": ["schema_version", "plan_id", "plan_sha256", "calibration_variant", "resolved_input_sha256", "network", "transport", "measurement", "conditions"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calibration_variant": {"const": "stock"},
    "resolved_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "network": {"type": "object"},
    "transport": {"type": "object"},
    "measurement": {"type": "object"},
    "conditions": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
