{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngi541.org/schemas/scientific-experiment-identity.schema.json",
  "title": "NGI541 provider-independent scientific experiment identity",
  "type": "object",
  "required": [
    "schema_version",
    "workload",
    "variants",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workload": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object"
    },
    "conditions": {
      "type": "array"
    },
    "comparison": {
      "type": "object"
    },
    "scheduling": {
      "type": "object"
    },
    "measurement_control": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
