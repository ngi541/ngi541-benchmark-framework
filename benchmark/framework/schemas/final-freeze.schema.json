{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngi541.org/schemas/final-freeze.schema.json",
  "title": "NGI541 R6.5.3h final-freeze definition",
  "type": "object",
  "required": ["schema_version", "freeze", "inputs", "policy", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "freeze": {
      "type": "object",
      "required": ["name", "claim_scope"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "claim_scope": {"const": "r6.5.3-final-freeze-no-performance-claim"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": [
        "network_evidence_config",
        "loadgen_runtime_config",
        "scientific_corpus_config",
        "transport_security_config",
        "dual_host_telemetry_config",
        "workload_planner_config"
      ],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "policy": {
      "type": "object",
      "required": ["selection", "resume", "reuse_complete_if_inputs_identical"],
      "properties": {
        "selection": {"const": "latest-compatible"},
        "resume": {"const": "resume-from-last-completed-phase"},
        "reuse_complete_if_inputs_identical": {"const": true}
      },
      "additionalProperties": false
    },
    "requirements": {"type": "object"}
  },
  "additionalProperties": false
}
