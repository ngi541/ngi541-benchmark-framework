{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngi541.org/schemas/result-manifest.schema.json",
  "title": "NGI541 scientific performance result manifest",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "source",
    "roles",
    "protocol",
    "design",
    "integrity",
    "primary_result",
    "claims",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "type",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^r[0-9]+-[0-9]+-[0-9]+-[0-9]+-http3-paired-result-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$"
        },
        "type": {
          "const": "scientific-performance-result"
        },
        "state": {
          "const": "COMPLETE"
        }
      }
    },
    "source": {
      "type": "object"
    },
    "roles": {
      "type": "object"
    },
    "protocol": {
      "type": "object"
    },
    "design": {
      "type": "object"
    },
    "integrity": {
      "type": "object"
    },
    "primary_result": {
      "type": "object"
    },
    "claims": {
      "type": "object"
    },
    "publication": {
      "type": "object"
    }
  }
}
