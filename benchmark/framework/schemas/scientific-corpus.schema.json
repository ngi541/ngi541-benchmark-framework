{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngi541.org/schemas/scientific-corpus.schema.json",
  "title": "NGI541 R6.5.3d scientific corpus definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus",
    "profile_registry",
    "profiles",
    "generator",
    "hacc",
    "materialization"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "claim_scope"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "claim_scope": {"type": "string", "minLength": 1}
      }
    },
    "profile_registry": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "profile_version"],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "profile_version": {"type": "integer", "minimum": 1}
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed_derivation", "byte_order"],
      "properties": {
        "algorithm": {"const": "splitmix64-v1"},
        "seed_derivation": {"const": "sha256-first-u64-be-v1"},
        "byte_order": {"const": "little-endian-u64"}
      }
    },
    "hacc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_assignment", "ordering", "coverage"],
      "properties": {
        "size_assignment": {"const": "capacity-weighted-largest-remainder-v1"},
        "ordering": {"const": "sha256-object-key-v1"},
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modes", "deterministic_stratified", "time_window"],
          "properties": {
            "modes": {
              "const": ["full", "deterministic-stratified", "time-window"]
            },
            "deterministic_stratified": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum_one_per_nonempty_bucket",
                "include_published_extrema"
              ],
              "properties": {
                "minimum_one_per_nonempty_bucket": {"const": true},
                "include_published_extrema": {"const": true}
              }
            },
            "time_window": {
              "type": "object",
              "additionalProperties": false,
              "required": ["selection"],
              "properties": {
                "selection": {"const": "ordered-prefix-through-byte-budget"}
              }
            }
          }
        }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_bytes"],
      "properties": {
        "chunk_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
