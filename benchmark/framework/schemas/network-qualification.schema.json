{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngi541.org/schemas/network-qualification.schema.json",
  "title": "NGI541 network qualification definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualification", "local", "remote", "tests"],
  "properties": {
    "schema_version": {"const": 1},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "claim_scope": {"type": "string"}
      }
    },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "provider"],
      "properties": {
        "role": {"enum": ["dut", "loadgen", "peer"]},
        "provider": {"const": "local"},
        "data_address": {"type": "string"}
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "provider", "ssh_target", "data_address"],
      "properties": {
        "role": {"enum": ["dut", "loadgen", "peer"]},
        "provider": {"const": "linux-ssh"},
        "ssh_target": {"type": "string", "minLength": 1},
        "data_address": {"type": "string", "minLength": 1},
        "connect_timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iperf3_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "ping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "count": {"type": "integer", "minimum": 1},
            "interval_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "tcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "duration_seconds": {"type": "integer", "minimum": 1},
            "parallel_streams": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "integer", "minimum": 1}
            }
          }
        },
        "udp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "duration_seconds": {"type": "integer", "minimum": 1},
            "datagram_bytes": {"type": "integer", "minimum": 1},
            "rates_mbps": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "udp_reference_max_loss_percent": {"type": "number", "minimum": 0}
      }
    }
  }
}
